# Root
DATABASE_URL=postgresql://salonslot:salonslot@localhost:5432/salonslot?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
AUTH_MODE=mock
PAYMENT_PROVIDER=mock
FEATURE_FLAGS=loyalty:false,referrals:false,subscriptions:false,orders:false,recommendations:false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
API_PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# Firebase (optional when AUTH_MODE=mock)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Razorpay (optional when PAYMENT_PROVIDER=mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# FCM
FCM_SERVER_CREDENTIALS=

# Mobile (apps/mobile/.env)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
EXPO_PUBLIC_AUTH_MODE=mock
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
