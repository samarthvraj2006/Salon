DATABASE_URL=postgresql://salonslot:salonslot@localhost:5432/salonslot?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
AUTH_MODE=mock
PAYMENT_PROVIDER=mock
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info
FEATURE_FLAGS=loyalty:false,referrals:false,subscriptions:false,orders:false,recommendations:false

# Optional Firebase Admin credentials (required for AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional live payment provider credentials (required for PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional service account JSON, minified onto one line, for push delivery
FCM_SERVER_CREDENTIALS=
GOOGLE_MAPS_API_KEY=
