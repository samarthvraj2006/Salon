generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SALON_OWNER
  SALON_STAFF
  ADMIN
}

enum PlaceType {
  SALON
  PHARMACY
  GROCERY
  FOOD
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PAY_AT_SALON
}

enum PaymentMethod {
  PAY_AT_SALON
  UPI
  CARD
  NETBANKING
  WALLET
}

enum PromotionType {
  FLAT
  PERCENT
  FIRST_BOOKING
}

model User {
  id             String         @id @default(cuid())
  firebaseUid    String?        @unique
  phone          String?        @unique
  email          String?        @unique
  name           String?
  avatarUrl      String?
  role           Role           @default(CUSTOMER)
  phoneVerified  Boolean        @default(false)
  emailVerified  Boolean        @default(false)
  city           String?
  lat            Float?
  lng            Float?
  notifyPush     Boolean        @default(true)
  notifySms      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
  deviceTokens   DeviceToken[]
  appointments   Appointment[]  @relation("CustomerAppointments")
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  waitlist       Waitlist[]
  payments       Payment[]
  redemptions    PromotionRedemption[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Place {
  id          String    @id @default(cuid())
  type        PlaceType
  name        String
  description String?
  address     String
  city        String
  lat         Float
  lng         Float
  phone       String?
  imageUrl    String?
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  isOpen      Boolean   @default(true)
  startingPrice Int?
  comingSoon  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  salon       Salon?

  @@index([city])
  @@index([lat, lng])
  @@index([type])
}

model Salon {
  id                String         @id @default(cuid())
  placeId           String         @unique
  ownerId           String?
  slotIntervalMin   Int            @default(15)
  cancelCutoffHours Int            @default(2)
  coverImages       String[]
  isFeatured        Boolean        @default(false)
  isNew             Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  place             Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  staff             SalonStaff[]
  services          Service[]
  workingHours      WorkingHours[]
  holidays          Holiday[]
  blockedSlots      BlockedSlot[]
  appointments      Appointment[]
  reviews           Review[]
  favorites         Favorite[]
  waitlist          Waitlist[]
  promotions        Promotion[]

  @@index([isFeatured])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  services Service[]
}

model Service {
  id          String           @id @default(cuid())
  salonId     String
  categoryId  String?
  name        String
  description String?
  durationMin Int
  priceInr    Int
  imageUrl    String?
  isActive    Boolean          @default(true)
  salon       Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id])
  staffLinks  StaffService[]
  appointmentServices AppointmentService[]
  waitlist    Waitlist[]

  @@index([salonId])
  @@index([categoryId])
}

model SalonStaff {
  id           String              @id @default(cuid())
  salonId      String
  name         String
  avatarUrl    String?
  title        String?
  isActive     Boolean             @default(true)
  salon        Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services     StaffService[]
  availability StaffAvailability[]
  appointments Appointment[]
  waitlist     Waitlist[]

  @@index([salonId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     SalonStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id        String @id @default(cuid())
  salonId   String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)
  salon     Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
}

model StaffAvailability {
  id        String     @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  breakStart String?
  breakEnd   String?
  staff     SalonStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  salonId   String
  staffId   String?
  startTime DateTime
  endTime   DateTime
  reason    String?
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, startTime])
}

model Holiday {
  id      String   @id @default(cuid())
  salonId String
  date    DateTime @db.Date
  name    String?
  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, date])
}

model Appointment {
  id             String               @id @default(cuid())
  bookingCode    String               @unique
  customerId     String
  salonId        String
  staffId        String
  date           DateTime             @db.Date
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus    @default(PENDING)
  paymentStatus  PaymentStatus        @default(PAY_AT_SALON)
  totalAmount    Int
  discountAmount Int                  @default(0)
  qrToken        String               @unique @default(cuid())
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       User                 @relation("CustomerAppointments", fields: [customerId], references: [id])
  salon          Salon                @relation(fields: [salonId], references: [id])
  staff          SalonStaff           @relation(fields: [staffId], references: [id])
  services       AppointmentService[]
  payment        Payment?
  review         Review?
  redemptions    PromotionRedemption[]

  @@index([salonId, date])
  @@index([staffId, startTime])
  @@index([customerId, status])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  priceInr      Int
  durationMin   Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Payment {
  id                String        @id @default(cuid())
  appointmentId     String        @unique
  userId            String
  amount            Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  provider          String        @default("mock")
  providerOrderId   String?
  providerPaymentId String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  salonId       String
  userId        String
  rating        Int
  comment       String?
  verified      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  salon         Salon       @relation(fields: [salonId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([salonId])
}

model Favorite {
  userId    String
  salonId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@id([userId, salonId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Waitlist {
  id               String     @id @default(cuid())
  userId           String
  salonId          String
  serviceId        String
  preferredStaffId String?
  date             DateTime   @db.Date
  notifiedAt       DateTime?
  createdAt        DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon            Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service          Service    @relation(fields: [serviceId], references: [id])
  preferredStaff   SalonStaff? @relation(fields: [preferredStaffId], references: [id])

  @@index([salonId, date])
}

model Promotion {
  id            String         @id @default(cuid())
  code          String?        @unique
  title         String
  description   String?
  type          PromotionType
  value         Int
  maxDiscount   Int?
  minAmount     Int            @default(0)
  salonId       String?
  city          String?
  bannerUrl     String?
  firstBookingOnly Boolean     @default(false)
  usageLimit    Int?
  usedCount     Int            @default(0)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean        @default(true)
  salon         Salon?         @relation(fields: [salonId], references: [id])
  redemptions   PromotionRedemption[]

  @@index([isActive, city])
}

model PromotionRedemption {
  id            String      @id @default(cuid())
  promotionId   String
  userId        String
  appointmentId String?
  discountAmount Int
  createdAt     DateTime    @default(now())
  promotion     Promotion   @relation(fields: [promotionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, promotionId])
}
